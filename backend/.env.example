# Plantilla de configuración de Kapataz. Copia a .env y rellena; .env no se versiona.
# En producción los valores viven en /opt/kapataz/.env (ADR-014), nunca en el repositorio.
# Esta lista es un contrato con plataforma-entrega: no se añaden ni renombran variables sin acordarlo.

# local | production. En production se desactivan /docs y /openapi.json y se exige
# COOKIE_SECURE=true y PUBLIC_BASE_URL con https.
APP_ENV=local

# Rol de la aplicación (kapataz_app): sin BYPASSRLS y sin ser propietario de tablas (ADR-024).
# Se admite postgresql:// o postgres://; la app usa el driver asyncpg.
DATABASE_URL=postgresql://kapataz_app:CAMBIAR@kapataz-db:5432/kapataz

# Rol propietario (kapataz_owner). Solo lo usa Alembic: cd backend && uv run alembic upgrade head
DATABASE_MIGRATION_URL=postgresql://kapataz_owner:CAMBIAR@kapataz-db:5432/kapataz

# Al menos 32 caracteres aleatorios. Firma los tokens CSRF.
# Por ejemplo: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# URL pública, sin barra final. Se usa en los enlaces de los emails.
# Producción: https://kapataz.kodigolab.es
PUBLIC_BASE_URL=http://localhost:8000

# Motor del LLM. En el Bloque 1 solo existe fake (FakeLlm, ADR-008).
LLM_BACKEND=fake

# Clave de la API de Claude. Sin uso hasta el Bloque 6. Solo en el servidor; nunca en el repositorio.
ANTHROPIC_API_KEY=

# RN-13: cerrado mientras queden pendientes legales. Con el registro cerrado solo se registran los emails
# de REGISTRATION_ALLOWLIST (separados por comas). Las cuentas de cortesía se crean con
# uv run kapataz-admin create-user --email <email>
REGISTRATION_OPEN=false
REGISTRATION_ALLOWLIST=

# fake | smtp. Con fake los emails no se envían (se registra solo que no se enviaron).
EMAIL_BACKEND=fake
# Puerto 465: SMTPS. Cualquier otro: STARTTLS obligatorio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Flag Secure de las cookies. true en producción (obligatorio). En local por http
# a otra IP que no sea localhost (por ejemplo, el móvil en la red local) hace falta false.
COOKIE_SECURE=false

# Versión que muestra /api/health. Hasta la 1.0.0, el commit desplegado (ADR-032).
GIT_COMMIT=dev
