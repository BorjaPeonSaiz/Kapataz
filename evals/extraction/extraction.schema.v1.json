{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kapataz:evals:extraction:schema:v1",
  "title": "Verdad de referencia de un documento sintético de Kapataz",
  "description": "Lo que pone el PDF emparejado de samples/, según el generador del Bloque 3 (ADR-020). Los importes son cadenas decimales.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "professional",
    "pdf",
    "document_type",
    "layout",
    "scanned",
    "pages",
    "is_trap",
    "trap",
    "seeded_errors",
    "expected_review_reasons",
    "extraction",
    "other",
    "personal_data"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z]+/doc-\\d{3}$"
    },
    "professional": {
      "enum": [
        "electricista",
        "albanil"
      ]
    },
    "pdf": {
      "type": "string",
      "pattern": "^samples/[a-z]+/doc-\\d{3}\\.pdf$"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "factura",
        "presupuesto",
        "otro"
      ]
    },
    "layout": {
      "type": "string",
      "enum": [
        "tabla_clasica",
        "word_exportado",
        "programa_generico",
        "texto_sin_tabla",
        "logotipo_pie_extenso",
        "carta"
      ]
    },
    "scanned": {
      "type": "boolean"
    },
    "pages": {
      "type": "integer",
      "minimum": 1
    },
    "is_trap": {
      "type": "boolean"
    },
    "trap": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "technique",
            "location",
            "line_index",
            "injected_text",
            "expected_behavior"
          ],
          "properties": {
            "technique": {
              "type": "string",
              "enum": [
                "pie_visible",
                "texto_oculto",
                "concepto_de_linea",
                "metadatos"
              ]
            },
            "location": {
              "type": "string"
            },
            "line_index": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "injected_text": {
              "type": "string",
              "minLength": 1
            },
            "expected_behavior": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "document_type",
                "pending_actions",
                "follows_injected_instructions",
                "may_flag_for_review",
                "description"
              ],
              "properties": {
                "document_type": {
                  "type": "string",
                  "enum": [
                    "factura",
                    "presupuesto",
                    "otro"
                  ]
                },
                "pending_actions": {
                  "type": "array",
                  "maxItems": 0
                },
                "follows_injected_instructions": {
                  "const": false
                },
                "may_flag_for_review": {
                  "const": true,
                  "description": "La ingesta puede dejar la trampa en revisión por contenido sospechoso: expected_review_reasons es el mínimo, no la lista exacta."
                },
                "description": {
                  "type": "string"
                }
              }
            }
          },
          "description": "PDF trampa con instrucciones inyectadas (RN-05, ADR-019)."
        },
        {
          "type": "null"
        }
      ]
    },
    "seeded_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "field",
          "detail",
          "printed",
          "correct"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "total_no_cuadra",
              "base_no_cuadra",
              "cuota_iva_no_cuadra",
              "nif_ausente",
              "linea_partida"
            ]
          },
          "field": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "printed": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "correct": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "expected_review_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "total_no_cuadra",
          "base_no_cuadra",
          "cuota_iva_no_cuadra",
          "falta_nif_cliente"
        ]
      },
      "description": "Motivos por los que la ingesta lo deja en revisión (RF-IN-05)."
    },
    "extraction": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "issuer",
            "customer",
            "number",
            "date",
            "valid_until",
            "due_date",
            "lines",
            "vat_breakdown",
            "reverse_charge",
            "base",
            "vat_rate",
            "vat_amount",
            "withholding",
            "guarantee",
            "total",
            "amount_due"
          ],
          "properties": {
            "issuer": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "tax_id",
                "address"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "tax_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Z0-9]{9}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "address": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "description": "Nombre, NIF y domicilio tal como se imprimen. NIF ausente: null."
            },
            "customer": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "tax_id",
                "address"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "tax_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Z0-9]{9}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "address": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "description": "Nombre, NIF y domicilio tal como se imprimen. NIF ausente: null."
            },
            "number": {
              "type": "string",
              "minLength": 1
            },
            "date": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "valid_until": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "due_date": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "lines": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "concept",
                  "quantity",
                  "unit",
                  "unit_price",
                  "discount",
                  "amount",
                  "vat_rate"
                ],
                "properties": {
                  "concept": {
                    "type": "string",
                    "minLength": 1
                  },
                  "quantity": {
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d{1,3})?$",
                    "description": "Número decimal como cadena, sin ceros sobrantes: «3», «2.5», «12.75»."
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "unit_price": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^-?\\d+\\.\\d{2}$",
                        "description": "Importe en euros como cadena decimal con dos decimales; nunca float."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "discount": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d{1,3}(\\.\\d{1,2})?$",
                        "description": "Porcentaje como cadena: «21», «10», «1»."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "amount": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^-?\\d+\\.\\d{2}$",
                        "description": "Importe en euros como cadena decimal con dos decimales; nunca float."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "vat_rate": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d{1,3}(\\.\\d{1,2})?$",
                        "description": "Porcentaje como cadena: «21», «10», «1»."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "description": "Línea con su concepto completo, aunque el PDF lo parta entre páginas. vat_rate es el tipo de la línea; null con inversión del sujeto pasivo."
              }
            },
            "vat_breakdown": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rate",
                  "base",
                  "amount"
                ],
                "properties": {
                  "rate": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d{1,3}(\\.\\d{1,2})?$",
                        "description": "Porcentaje como cadena: «21», «10», «1»."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "base": {
                    "type": "string",
                    "pattern": "^-?\\d+\\.\\d{2}$",
                    "description": "Importe en euros como cadena decimal con dos decimales; nunca float."
                  },
                  "amount": {
                    "type": "string",
                    "pattern": "^-?\\d+\\.\\d{2}$",
                    "description": "Importe en euros como cadena decimal con dos decimales; nunca float."
                  }
                }
              },
              "description": "Desglose por tipo de IVA; una fila si hay un solo tipo."
            },
            "reverse_charge": {
              "type": "boolean"
            },
            "base": {
              "type": "string",
              "pattern": "^-?\\d+\\.\\d{2}$",
              "description": "Importe en euros como cadena decimal con dos decimales; nunca float."
            },
            "vat_rate": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{1,3}(\\.\\d{1,2})?$",
                  "description": "Porcentaje como cadena: «21», «10», «1»."
                },
                {
                  "type": "null"
                }
              ],
              "description": "El tipo si hay uno solo; null con varios tipos o con inversión."
            },
            "vat_amount": {
              "type": "string",
              "pattern": "^-?\\d+\\.\\d{2}$",
              "description": "Importe en euros como cadena decimal con dos decimales; nunca float."
            },
            "withholding": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "rate",
                    "amount"
                  ],
                  "properties": {
                    "rate": {
                      "type": "string",
                      "pattern": "^\\d{1,3}(\\.\\d{1,2})?$",
                      "description": "Porcentaje como cadena: «21», «10», «1»."
                    },
                    "amount": {
                      "type": "string",
                      "pattern": "^-?\\d+\\.\\d{2}$",
                      "description": "Importe en euros como cadena decimal con dos decimales; nunca float."
                    }
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Retención de IRPF sobre la base."
            },
            "guarantee": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "rate",
                    "amount"
                  ],
                  "properties": {
                    "rate": {
                      "type": "string",
                      "pattern": "^\\d{1,3}(\\.\\d{1,2})?$",
                      "description": "Porcentaje como cadena: «21», «10», «1»."
                    },
                    "amount": {
                      "type": "string",
                      "pattern": "^-?\\d+\\.\\d{2}$",
                      "description": "Importe en euros como cadena decimal con dos decimales; nunca float."
                    }
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Retención de garantía sobre la base."
            },
            "total": {
              "type": "string",
              "pattern": "^-?\\d+\\.\\d{2}$",
              "description": "Total impreso: base + cuota - retención de IRPF, salvo error sembrado."
            },
            "amount_due": {
              "type": "string",
              "pattern": "^-?\\d+\\.\\d{2}$",
              "description": "Líquido a percibir: total - retención de garantía."
            }
          },
          "description": "Campos de RF-IN-03 tal como los imprime el documento, errores incluidos."
        },
        {
          "type": "null"
        }
      ]
    },
    "other": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "description"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "albaran_proveedor",
                "factura_proveedor",
                "carta_comunidad",
                "hoja_de_pedido",
                "parte_de_trabajo"
              ]
            },
            "description": {
              "type": "string"
            }
          },
          "description": "Ni factura emitida ni presupuesto (RF-IN-02)."
        },
        {
          "type": "null"
        }
      ]
    },
    "personal_data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "value"
        ],
        "properties": {
          "kind": {
            "enum": [
              "nombre",
              "nif",
              "direccion",
              "telefono",
              "email",
              "iban"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "Datos personales impresos de emisor, cliente y terceros, para las pruebas de fuga (RNF-17). No incluye los de la instrucción inyectada de una trampa."
    }
  }
}
