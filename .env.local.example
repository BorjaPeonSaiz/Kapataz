# Entorno local de Kapataz. Copia este fichero a .env.local (ignorado por git):
#
#   cp .env.local.example .env.local
#
# Solo datos sintéticos y valores de desarrollo. Nunca claves de producción
# ni la clave real de la API de Claude.
#
# Compose lo usa dos veces: para interpolar docker-compose.yml (--env-file) y
# como env_file de la app (KAPATAZ_ENV_FILE). Las referencias ${VAR} de abajo
# las resuelve Compose con valores de este mismo fichero.
# Usa contraseñas y claves solo con letras y números (por ejemplo,
# openssl rand -hex 32): van dentro de URL y Compose interpreta el carácter $.

# ---------------------------------------------------------------- Compose
# Etiqueta de la imagen local. Nunca latest.
KAPATAZ_IMAGE_TAG=local
KAPATAZ_ENV_FILE=.env.local

# ---------------------------------------------------------------- PostgreSQL
# kapataz-db y deploy/postgres-init/10-roles.sh los usan al crear el
# volumen. Si los cambias después, borra el volumen kapataz-db-data local.
# Compose los usa además para componer las URL de conexión; a kapataz y a
# kapataz-worker les llegan vacíos.
POSTGRES_PASSWORD=local-postgres-password
KAPATAZ_OWNER_DB_PASSWORD=local-owner-password
KAPATAZ_APP_DB_PASSWORD=local-app-password

# ---------------------------------------------------------------- App
APP_ENV=local
# Rol de la aplicación: sin BYPASSRLS ni propiedad de tablas.
DATABASE_URL=postgresql+asyncpg://kapataz_app:${KAPATAZ_APP_DB_PASSWORD}@kapataz-db:5432/kapataz
# DATABASE_MIGRATION_URL (rol propietario, kapataz_owner) no va aquí: la
# compone docker-compose.yml solo para kapataz-tools, que ejecuta las
# migraciones. kapataz y kapataz-worker nunca la reciben (ADR-024).
SECRET_KEY=local-secret-key-solo-para-desarrollo-no-usar-en-produccion
PUBLIC_BASE_URL=http://localhost:8000
COOKIE_SECURE=false
# Sin proxy delante en local.
FORWARDED_ALLOW_IPS=127.0.0.1

# ---------------------------------------------------------------- IA
LLM_BACKEND=fake
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- Registro
REGISTRATION_OPEN=false
REGISTRATION_ALLOWLIST=

# ---------------------------------------------------------------- Email
EMAIL_BACKEND=fake
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Kapataz <no-reply@localhost>

# GIT_COMMIT no va aquí: entra en la imagen como argumento de construcción.
