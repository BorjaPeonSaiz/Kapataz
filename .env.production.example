# Plantilla de /opt/kapataz/.env (producción, https://kapataz.kodigolab.es).
# Este fichero se versiona y NUNCA lleva secretos. El .env real solo existe en
# el servidor, con permisos 600 (docs/operacion/despliegue.md).
#
#   cp .env.production.example .env && chmod 600 .env
#
# Genera cada contraseña y clave con: openssl rand -hex 32
# Solo letras y números: van dentro de URL y Compose interpreta el carácter $.
#
# KAPATAZ_IMAGE_TAG no va aquí: lo fija deploy/deploy.sh en cada despliegue.
# GIT_COMMIT tampoco: entra en la imagen al construirla.

# ---------------------------------------------------------------- PostgreSQL
# kapataz-db los usa solo la primera vez (al crear el volumen
# kapataz-db-data). Cambiarlos después no cambia las contraseñas de la BD.
# Compose los usa además para componer las URL de conexión; a kapataz y a
# kapataz-worker les llegan vacíos.
POSTGRES_PASSWORD=
KAPATAZ_OWNER_DB_PASSWORD=
KAPATAZ_APP_DB_PASSWORD=

# ---------------------------------------------------------------- App
APP_ENV=production
# Rol de la aplicación: sin BYPASSRLS ni propiedad de tablas.
DATABASE_URL=postgresql+asyncpg://kapataz_app:${KAPATAZ_APP_DB_PASSWORD}@kapataz-db:5432/kapataz
# DATABASE_MIGRATION_URL (rol propietario, kapataz_owner) no va aquí: la
# compone docker-compose.yml solo para kapataz-tools, que ejecuta las
# migraciones. kapataz y kapataz-worker nunca la reciben (ADR-024).
# Clave que firma los tokens CSRF (las sesiones son tokens aleatorios guardados
# con hash, no dependen de ella): openssl rand -hex 32
SECRET_KEY=
PUBLIC_BASE_URL=https://kapataz.kodigolab.es
COOKIE_SECURE=true
# Subred de kronoqr-app: uvicorn solo acepta X-Forwarded-* del nginx de
# KronoQR (ADR-014). Compruébala con:
#   docker network inspect kronoqr-app --format '{{(index .IPAM.Config 0).Subnet}}'
FORWARDED_ALLOW_IPS=172.18.0.0/16

# ---------------------------------------------------------------- IA
# Bloque 1: FakeLlm. La clave real de la API de Claude entra en su bloque y
# solo existe en este fichero del servidor.
LLM_BACKEND=fake
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- Registro
# Mientras queden pendientes legales el registro está cerrado (RN-13; publicar
# la 1.0.0 no lo abre): solo cuentas de cortesía
# creadas con kapataz-admin, o los emails de la lista.
REGISTRATION_OPEN=false
REGISTRATION_ALLOWLIST=

# ---------------------------------------------------------------- Email
# Proveedor SMTP en la UE.
EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Kapataz <no-reply@kodigolab.es>
